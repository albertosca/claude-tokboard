.superpowers/
# Only the agent worktree scratch, NOT all of .claude/ - a project
# .claude/settings.json is a real, shareable config file and ignoring
# the whole directory would silently swallow it.
.claude/worktrees/
.venv/
__pycache__/
.DS_Store
node_modules/
.coverage
# The planning docs live in a private repository and are symlinked in
# here. No trailing slash: git sees a symlink as a file, and a "dir/"
# pattern matches only real directories - it would not ignore the link.
/docs/superpowers
# The project installs with pip (requirements-*.txt); a uv lockfile is a local
# by-product of running uv here, not something the repo pins.
uv.lock
